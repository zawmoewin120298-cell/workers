import { connect } from 'cloudflare:sockets';

// သင်၏ UUID (v2rayNG ထဲက UUID နဲ့ တူရပါမယ်)
const UUID = 'f55ce6cc-3f6b-40fc-9e3b-abe26db17009';

export default {
  async fetch(request, env, ctx) {
    const upgradeHeader = request.headers.get('Upgrade');
    if (!upgradeHeader || upgradeHeader !== 'websocket') {
      return new Response('VLESS Worker is running smoothly!', { status: 200 });
    }

    const webSocketPair = new WebSocketPair();
    const [client, server] = Object.values(webSocketPair);
    server.accept();

    ctx.waitUntil(handleVlessSession(server, UUID));

    return new Response(null, {
      status: 101,
      webSocket: client,
    });
  },
};

async function handleVlessSession(webSocket, userID) {
  let remoteSocket = null;
  let isHeaderParsed = false;

  webSocket.addEventListener('message', async (event) => {
    try {
      const messageData = event.data;
      if (!isHeaderParsed) {
        const vlessBuffer = new Uint8Array(messageData);
        if (vlessBuffer.byteLength < 24) return;

        // Extract Port and Address
        const port = new DataView(vlessBuffer.buffer).getUint16(18);
        const addressType = vlessBuffer[20];
        let addressIndex = 21;
        let address = '';

        if (addressType === 1) { // IPv4
          address = vlessBuffer.slice(21, 25).join('.');
          addressIndex = 25;
        } else if (addressType === 2) { // Domain Name
          const addressLen = vlessBuffer[21];
          addressIndex = 22;
          address = new TextDecoder().decode(vlessBuffer.slice(addressIndex, addressIndex + addressLen));
          addressIndex += addressLen;
        } else if (addressType === 3) { // IPv6
          addressIndex = 21;
          address = '[::1]';
        }

        const rawClientData = vlessBuffer.slice(addressIndex + 2);
        isHeaderParsed = true;

        // Connect to destination via Cloudflare Sockets
        remoteSocket = connect({ hostname: address, port: port });
        
        // Send VLESS response header back to client
        webSocket.send(new Uint8Array([vlessBuffer[0], 0]));

        const writer = remoteSocket.writable.getWriter();
        if (rawClientData.byteLength > 0) {
          await writer.write(rawClientData);
        }
        writer.releaseLock();

        // Pipe data back from remote socket to WebSocket client
        remoteSocket.readable.pipeTo(new WritableStream({
          write(chunk) {
            webSocket.send(chunk);
          },
          close() { webSocket.close(); },
          abort() { webSocket.close(); }
        })).catch(() => {});

      } else {
        if (remoteSocket) {
          const writer = remoteSocket.writable.getWriter();
          await writer.write(messageData);
          writer.releaseLock();
        }
      }
    } catch (err) {
      console.error('Session error:', err);
    }
  });

  webSocket.addEventListener('close', () => {
    if (remoteSocket) remoteSocket.close();
  });
  webSocket.addEventListener('error', () => {
    if (remoteSocket) remoteSocket.close();
  });
}
